# AI is intentionally disabled by default so local development never incurs a
# surprise API call. Set AI_PROVIDER to gemini or ollama when you are ready.
AI_PROVIDER=manual

# Gemini (server-only; never prefix this key with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Ollama local runtime
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss

# Shared reliability controls
AI_TIMEOUT_MS=15000
AI_MAX_ATTEMPTS=2

# Supabase public configuration. The publishable key is intentionally safe for
# browser use; database authorization is enforced with Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
